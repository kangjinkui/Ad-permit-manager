                                  "checks":  [
                                                 {
                                                     "key":  "row1",
                                                     "label":  "지 역",
                                                     "standardText":  "○ 상업지역, 공업지역 기타지역(자사건물일 경우 가능)"
                                                 },
                                                 {
                                                     "key":  "row2",
                                                     "label":  "건 물",
                                                     "standardText":  "○ 5층 이상 15층 이하 건물 (영15조3호 가목) ○ 16층 이상 건물에 건물명이나, 자사광고를 입체형 또는 도료로 직접 표시하는 경우 (시행령 제15조 제4호 가목)"
                                                 },
                                                 {
                                                     "key":  "row3",
                                                     "label":  "규 격",
                                                     "standardText":  "○ 가로 : 30m 이내 면적합계 : 1천50제곱미터 이내 높이 : 건물높이 1/2 이내로 최고 15m 이내"
                                                 },
                                                 {
                                                     "key":  "row4",
                                                     "label":  "수 량",
                                                     "standardText":  "○ 1업소 1개(상업지역)"
                                                 },
                                                 {
                                                     "key":  "row5",
                                                     "label":  "조명설치",
                                                     "standardText":  "○ 백열등, 형광등 사용 시, 간판의 외부에 직접 노출되지 않도록 함 ○ 빛이 점멸하거나 동영상 변화가 있는 광고물을 차량진행방향 정면으로 표시하는 경우, 지면으로부터 10m 이상 이격, 교통신호기로부터 직선거리 30m 이내 경우 지면으로부터 15m 이상 이격(영 제14조3항, 4항)"
                                                 },
                                                 {
                                                     "key":  "row6",
                                                     "label":  "이격거리",
                                                     "standardText":  "○ 옥상간판 수평거리 50m 이상 유지 (전자식 전광판은 수평거리 200m 이상)"
                                                 }
                                             ]
                              },
